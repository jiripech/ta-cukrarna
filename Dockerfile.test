FROM mcr.microsoft.com/playwright:v1.58.2-jammy

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (force to skip platform check)
RUN npm ci --force

# Install Playwright browsers
RUN npx playwright install

# Copy source code
COPY . .

# Set environment variable to enable dev mode in PHP endpoint during tests
ENV PLAYWRIGHT_TEST_MODE=true

# Build the app
RUN npm run build

# Run E2E tests
CMD ["npm", "run", "test:e2e"]

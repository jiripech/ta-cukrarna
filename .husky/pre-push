#!/bin/sh
# Pre-push hook for ta-cukrarna
#
# 1. Releases: ensures newly-pushed release tags (vX.Y.Z) are strictly
#    incremental, aborts the push otherwise.
#
# 2. Version sync: when a valid release tag is pushed, keeps the on-disk
#    version files (public/version.txt, package.json, package-lock.json) in
#    sync with that tag. If they differ, the hook rewrites them, creates a
#    sync commit, re-points the local tag at that commit, and reports what it
#    did. This guarantees the deployed build (which reads these files from the
#    pushed tag) shows the correct version footer.
#
# Run via `sh -e` (husky helper). Guard against set -e aborting on expected
# non-zero statuses (no remote tags, grep misses).

set +e

HIGHEST_REMOTE_TAG=$(git ls-remote --tags origin 2>/dev/null | awk '{print $2}' | sed 's#refs/tags/##' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n1)

guard_error=""
sync_report=""
sync_failed=""

sync_version_files() {
  local tag="$1"      # e.g. v1.2.3
  local ver="${tag#v}" # e.g. 1.2.3

  local pkg_ver pkglock_ver txt_ver
  pkg_ver=$(node -p "require('./package.json').version" 2>/dev/null)
  pkglock_ver=$(node -p "require('./package-lock.json').version" 2>/dev/null)
  txt_ver=$(sed -nE 's/^Version: v([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' public/version.txt 2>/dev/null | head -n1)

  if [ "$pkg_ver" = "$ver" ] && [ "$pkglock_ver" = "$ver" ] && [ "$txt_ver" = "$ver" ]; then
    return 0
  fi

  # Rewrite the version files.
  if ! node -e "
    const fs = require('fs');
    const ver = '$ver';
    for (const f of ['package.json', 'package-lock.json']) {
      const p = JSON.parse(fs.readFileSync(f, 'utf8'));
      p.version = ver;
      fs.writeFileSync(f, JSON.stringify(p, null, 2) + '\n');
    }
    fs.writeFileSync('public/version.txt', 'Version: v' + ver + '\n');
  " 2>/dev/null; then
    sync_failed="$sync_failed  ✗ failed to rewrite version files to $tag\n"
    return 1
  fi

  # Commit the sync.
  git add package.json package-lock.json public/version.txt
  if ! git commit -s -S -m "🔖 Sync version files to $tag" >/dev/null 2>&1; then
    sync_failed="$sync_failed  ✗ failed to commit version sync for $tag\n"
    return 1
  fi

  # Re-point the local tag at the new sync commit.
  if ! git tag -a -s -f -m "Release $tag" "$tag" >/dev/null 2>&1; then
    sync_failed="$sync_failed  ✗ failed to re-point tag $tag at sync commit\n"
    return 1
  fi

  sync_report="$sync_report  ✓ $tag: synced version files and re-pointed the local tag\n"
  return 0
}

# NOTE (important): git resolves the ref OIDs to push *before* invoking this
# hook, so re-pointing a tag here does NOT change what the in-flight push sends.
# The remote would receive the stale, pre-sync tag. To push the corrected,
# re-pointed tag we must abort this push and have the user re-run it; on the
# second pass the version files already match and the re-pointed tag is pushed.

# Read pre-push stdin lines: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_ref" = "" ] && break
  case "$local_ref" in
    refs/tags/v[0-9]*\.[0-9]*\.[0-9]*)
      local_tag=${local_ref#refs/tags/}
      if [ -n "$HIGHEST_REMOTE_TAG" ]; then
        HIGHER=$(printf '%s\n%s\n' "$local_tag" "$HIGHEST_REMOTE_TAG" | sort -V | tail -n1)
        if [ "$HIGHER" = "$HIGHEST_REMOTE_TAG" ]; then
          guard_error="$guard_error  ✗ tag '$local_ref' is not strictly greater than existing '$HIGHEST_REMOTE_TAG'\n"
        fi
      fi
      sync_version_files "$local_tag"
      ;;
  esac
done < /dev/stdin

if [ -n "$guard_error" ]; then
  echo ""
  echo "❌ Pre-push check rejected non-incremental release tag(s):"
  printf "$guard_error"
  echo ""
  echo "Release tags must be strictly greater than the current highest ($HIGHEST_REMOTE_TAG)."
  echo "If this was intentional, use 'git push --no-verify' after double-checking."
  echo ""
  exit 1
fi

if [ -n "$sync_failed" ]; then
  echo ""
  echo "⚠️  Version sync failed for some tag(s):"
  printf "$sync_failed"
  echo ""
  echo "The push will be aborted so you can inspect the repository state."
  echo ""
  exit 1
fi

if [ -n "$sync_report" ]; then
  echo ""
  echo "🔖 Version sync performed during pre-push:"
  printf "$sync_report"
  echo ""
  echo "⚠️  The in-flight push carried the OLD tag, so it was aborted."
  echo "Please run the same push again (git push --follow-tags) to send the"
  echo "re-pointed tag with the synced version files."
  echo ""
  exit 1
fi

exit 0
